  - m_Id: 22216684384919552
    m_Localized: "\uC55E\uC73C\uB85C \uC774\uB3D9, \uB300\uAC01\uC120 \uC55E \uACF5\uACA9,
      \uC774\uB3D9 \uD6C4 \uD55C \uD134 \uC27C"
